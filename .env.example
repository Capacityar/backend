# ─────────────────────────────────────────────────────────────
# Capacity AR API — variables de entorno
# Copiar a .env (cp .env.example .env) y completar los secretos.
# Fuente de verdad: app/config.py (clase Settings). Mantener en sync.
# ─────────────────────────────────────────────────────────────

# App
APP_NAME=Capacity AR API
APP_ENV=local          # local | production
APP_DEBUG=true         # false en producción

# Base de datos
# Postgres (prod/docker). Render/Neon entregan URLs sin driver; config.py
# normaliza postgres:// y postgresql:// a postgresql+psycopg://.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/capacity_ar
# Alternativa para desarrollo local sin Postgres:
# DATABASE_URL=sqlite:///./capacity_ar_local.db

# CORS (orígenes permitidos separados por coma)
# Por defecto: http://localhost:5173,https://capacity-ar.vercel.app
CORS_ORIGINS=http://localhost:5173,https://capacity-ar.vercel.app

# Generador de planes / IA
# mock = determinístico sin IA (default). groq / gemini usan LLM con fallback a mock.
PLAN_GENERATOR=mock

# Groq (secreto — no commitear el valor real)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (secreto — no commitear el valor real)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Routing
API_TARGET=/api
